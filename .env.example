# Configurar estos valores como variables de entorno en cPanel. No subir un .env real.
CLAMI_API_KEY=clami_cat_reemplazar
MANYCHAT_SECRET=crear-un-secreto-aleatorio-largo-y-unico
# PORT no se define en cPanel: lo entrega Passenger. La aplicacion usa 3000 solo
# cuando se ejecuta a mano fuera del hosting. Definirlo con un valor invalido
# detiene el arranque con un mensaje claro, en vez de dejarlo pasar.
NODE_ENV=production

# Opcionales
LOG_DIR=./logs
DATA_DIR=./data
ADMIN_STATUS_TOKEN=crear-otro-secreto-aleatorio-largo
