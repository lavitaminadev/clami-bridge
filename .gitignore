# Secretos y configuración con credenciales.
# `.env` cubre el archivo exacto; `.env.*` cubre las variantes que aparecen en
# la práctica (.env.produccion, .env.local, .env.bak) y que de otro modo se
# versionarían sin que nadie lo note. La plantilla sí se publica.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
id_ed25519*
.npmrc
.netrc
*credential*
*credencial*
*secret*
*secreto*
ACCESOS*
CLAVES*
*cookies*


# Estado en ejecución y registros. Reflejan operación real y crecen sin límite.
logs/
data/
test-logs/
test-data/
*.jsonl
*.log
*.lock
!package-lock.json

# cPanel crea public en la raiz al dar de alta la aplicacion Node. No es del
# proyecto y queda sin rastrear, lo que deja el arbol sucio: con el arbol sucio
# cPanel se niega a desplegar, sin decir cual es el archivo.
public/

# Dependencias y cachés
node_modules
tmp/
.npm/
.cache/

# Respaldos y comprimidos
*.zip
*.tar
*.tar.gz
*.rar
*.bak
*.backup
*.old
*.orig
*.dump
*.sql

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
*.lnk

# Editores
.vscode/
.idea/
*.swp
*~
